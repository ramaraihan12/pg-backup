# Secrets for pg-backup. Copy to .env. These are never read from the YAML file.
# The values below match the local docker-compose.yml and are for local use only.

# password for the user in database.url
PGBACKUP_DB_PASSWORD=postgres

# S3 keys. For the MinIO in docker-compose.yml these are its root user and password.
PGBACKUP_S3_ACCESS_KEY=pgbackup
PGBACKUP_S3_SECRET_KEY=pgbackup-secret

# age key pair, from: docker compose run --rm pg-backup keygen
# The public key is not secret. The private key (AGE-SECRET-KEY-...) is needed
# to restore and to run the drill, so keep a copy outside the bucket.
PGBACKUP_AGE_RECIPIENT=
PGBACKUP_AGE_IDENTITY=

# Failure alerts, only used when notify.telegram is true (or PGBACKUP_TELEGRAM=true)
PGBACKUP_TELEGRAM_TOKEN=
PGBACKUP_TELEGRAM_CHAT_ID=
